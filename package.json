{
  "name": "circuito-2-nacional",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "node scripts/run-ui-tests.mjs",
    "build": "node scripts/generate-static-catalog.mjs && tsc --noEmit && vite build",
    "check:data": "node --experimental-strip-types scripts/check-data.ts",
    "check:dist": "node scripts/check-dist.mjs",
    "generate:static": "node scripts/generate-static-catalog.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
